# Copy to .env for local developer configuration. NEVER commit .env or any API key.

# --- AI Clinical Copilot (optional) --------------------------------------------------------------
# Testers can instead enter their own key in the app: Doctor → AI Clinical Copilot → Configure AI.
# A key entered in the app takes precedence for that browser session and is never stored.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Default: gemini-3.8-flash (Gemini API free tier). Alternatives: gemini-3.5-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Set to false to disable live AI entirely (the Copilot then offers only a labelled demo response).
AI_ENABLED=true

# Defaults to sqlite:///data/healthbridge.db
# DATABASE_URL=sqlite:///data/healthbridge.db
