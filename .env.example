# Copy to .env for local developer configuration. NEVER commit .env or any API key.
# Everything here is optional — HealthBridge runs without a .env file.

# --- AI Clinical Copilot (optional) --------------------------------------------------------------
# Testers can instead enter their own key in the app: Doctor → AI Clinical Copilot → Configure AI.
# A key entered in the app takes precedence for that browser session and is never stored.
# Do NOT configure a shared key on a public deployment: every visitor would use it.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Default: gemini-3.8-flash. Also selectable in the app: gemini-3.5-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Set to false to disable live AI entirely (the Copilot then offers only a labelled demo response).
AI_ENABLED=true

# --- Storage (optional) ------------------------------------------------------------------------------
# Defaults to sqlite:///data/healthbridge.db (created and seeded automatically on first start)
# DATABASE_URL=sqlite:///data/healthbridge.db
# Defaults to data/uploads
# UPLOAD_DIR=data/uploads
