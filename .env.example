# Copy to .env and fill in. Never commit .env.

# Optional. Without a key and model, HealthBridge uses deterministic (rule-based) fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=

# Set to false to force the deterministic fallback even when a key is present.
AI_ENABLED=true

# Defaults to sqlite:///data/healthbridge.db
# DATABASE_URL=sqlite:///data/healthbridge.db
